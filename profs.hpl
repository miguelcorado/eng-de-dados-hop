  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT 
    u.nome AS nome, 
    p.tipo_jornada_trabalho AS jornada, 
    p.formacao AS formacao, 
    d.nome AS nome_depto
FROM universidade.professor p
INNER JOIN universidade.usuario u ON p.cpf = u.cpf
LEFT JOIN universidade.departamento d ON p.departamento = d.cod_depto;</sql>
    <limit>0</limit>

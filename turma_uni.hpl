  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT 
    t.cod_disc AS codigo_disciplina,
    t.ano,
    t.semestre AS periodo,
    u.nome AS nome_professor,
    COUNT(c.mat_estudante) AS n_discentes,
    COALESCE(ROUND(AVG(c.nota)::numeric, 2), 0) AS media,
    SUM(CASE WHEN c.nota >= 5.0 THEN 1 ELSE 0 END) AS aprovados,
    SUM(CASE WHEN c.nota &lt; 5.0 THEN 1 ELSE 0 END) AS reprovados
FROM universidade.turma t
LEFT JOIN universidade.leciona l ON t.id_turma = l.id_turma
LEFT JOIN universidade.professor p ON l.mat_professor = p.mat_professor
LEFT JOIN universidade.usuario u ON p.cpf = u.cpf
LEFT JOIN universidade.cursa c ON t.id_turma = c.id_turma
GROUP BY 
    t.id_turma, t.cod_disc, t.ano, t.semestre, u.nome;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>aws_rds_uni</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>80</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
